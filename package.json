{
  "name": "steakz-mis",
  "version": "1.0.0",
  "description": "Steakz — Management Information System web portal (multi-branch restaurant chain) for DATASAP / OTHM L5 MIS.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:auth": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPattern=auth",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.5",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.0",
    "@types/supertest": "7.2.0",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
