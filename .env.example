# ─────────────────────────────────────────────────────────────
# Steakz MIS — Environment Variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL 15+)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/steakz_db"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/steakz_test_db"

# Auth
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Admin seed (used by prisma/seed.ts only)
ADMIN_EMAIL="admin@steakz.co.uk"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="System Administrator"

# Server
PORT=3000
NODE_ENV=development

# Frontend origin (CORS)
FRONTEND_URL="http://localhost:5173"
